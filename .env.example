# ===== Confluence =====
CONFLUENCE_URL=...
CONFLUENCE_API_KEY=...
CONFLUENCE_SPACE_NAME=...

# ===== LLM Provider =====
USE_LLM_API=true
LLM_API_KEY=...
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ===== Ollama (резерв) =====
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://ollama:11434

# ===== ChromaDB =====
CHROMA_DB_PATH=/app/data/chroma_db
CHROMA_COLLECTION=confluence_index

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ===== Parent-Child Поиск =====
# Маленькие чанки для точного поиска (семантический индекс)
CHILD_CHUNK_SIZE=250
CHILD_CHUNK_OVERLAP=30

# Большие блоки для контекста LLM (полные разделы)
PARENT_BLOCK_SIZE=2000
PARENT_CHUNK_OVERLAP=200

# Сколько child-чанков максимум группируем в один parent
CHILDREN_PER_PARENT=8

# Максимум parent-блоков в контексте для LLM
MAX_PARENT_BLOCKS=4

# Минимальный score child-чанка для попадания parent в контекст
CHILD_MIN_SCORE=0.51

# ===== RAG Pipeline =====
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
RERANK_MIN_SCORE=0.43
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DENSE_MODEL=intfloat/multilingual-e5-large
MAX_CONTEXT_TOKENS=8000

# ===== Структура контента =====
TABLE_FORMAT=markdown
INCLUDE_HEADERS_IN_CHUNKS=true
MAX_HEADER_DEPTH=3

# ===== Telegram Bot =====
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8443

# ===== Синхронизация =====
FORCE_RELOAD=false
SKIP_LOAD=false
ENABLE_PERIODIC_SYNC=false

# ===== Логирование =====
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
TOKENIZERS_PARALLELISM=true
FORCE_CPU=false